# Optional NVR storage paths (defaults to /data and /recordings inside Docker,
# automatically falling back to ./data and ./recordings when root paths are not writable).
DATA_DIR="/data"
RECORDINGS_DIR="/recordings"

# Server listening port
PORT="3000"

# --- Login / security (see README: "Login & Security") ---
# Create the admin account from the environment instead of the first-run screen
# (only used when no account exists yet):
# NVR_ADMIN_USER="admin"
# NVR_ADMIN_PASSWORD="choose-a-long-password"

# Number of reverse proxies in front of xlab-nvr (so login rate limiting sees real client IPs):
# TRUST_PROXY="1"

# Only if your proxy rewrites the Host header and sign-in is blocked as cross-origin:
# NVR_ALLOWED_ORIGINS="nvr.example.com"

# Turns the login OFF. Only use behind another access layer (mTLS, VPN):
# NVR_AUTH_DISABLED="true"
